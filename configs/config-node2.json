{
  "_comment": "Node 2 config",
  "name": "qau-node-2",
  "dataDir": "./data2",
  "network": "dev",
  "listenAddr": ":9001",
  "bootstrapPeers": [
    "127.0.0.1:9000",
    "127.0.0.1:9002"
  ],
  "maxPeers": 20,
  "rpcEnabled": true,
  "rpcAuthEnabled": true,
  "rpcAddr": "127.0.0.1:8547",
  "wsEnabled": true,
  "wsAddr": "127.0.0.1:8548",
  "frontendEnabled": false,
  "healthEnabled": true,
  "healthAddr": "127.0.0.1:8081",
  "validatorEnabled": true,
  "validatorKey": "",
  "cacheSize": 256,
  "maxGasLimit": 20000000,
  "logLevel": "info",
  "logFormat": "json",
  "shutdownTimeout": 30,
  "blockProducer": false,
  "allowLegacySignatures": false,
  "parallelExecution": {
    "enabled": true,
    "numWorkers": 2,
    "maxRetries": 3
  },
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "_validatorKeyEnv": "QAU_VALIDATOR_KEY"
}
